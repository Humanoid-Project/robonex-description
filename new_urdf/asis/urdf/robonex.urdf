    <!-- [Joint] l_hip_yaw_joint -->
    <joint name="l_hip_yaw_joint" type="revolute">
        <parent link="base_link"/>
        <child link="l_hip_yaw_link"/>
        <origin xyz="0.009587 0.043073 -0.157994" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <!-- RS02 ID1 : limit -180 ~ +180 deg until the Ver.2 joint-limit sweep -->
        <limit lower="-3.141593" upper="3.141593" effort="17.0" velocity="42.9"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <!-- [Joint] l_hip_pitch_joint -->
    <joint name="l_hip_pitch_joint" type="revolute">
        <parent link="l_hip_yaw_link"/>
        <child link="l_hip_pitch_link"/>
        <origin xyz="0.000002 0.025750 -0.062000" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>
        <!-- RS03 ID2 : limit -180 ~ +180 deg until the Ver.2 joint-limit sweep -->
        <limit lower="-3.141593" upper="3.141593" effort="60.0" velocity="20.9"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <!-- [Joint] l_hip_roll_joint -->
    <joint name="l_hip_roll_joint" type="revolute">
        <parent link="l_hip_pitch_link"/>
        <child link="l_hip_roll_link"/>
        <origin xyz="0.022500 0.062699 -0.034000" rpy="0 0 0"/>
        <axis xyz="-1 0 0"/>
        <!-- RS03 ID3 : limit -180 ~ +180 deg until the Ver.2 joint-limit sweep -->
        <limit lower="-3.141593" upper="3.141593" effort="60.0" velocity="20.9"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <!-- [Joint] l_knee_joint -->
    <joint name="l_knee_joint" type="revolute">
        <parent link="l_hip_roll_link"/>
        <child link="l_knee_link"/>
        <origin xyz="-0.034799 0.002900 -0.312746" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-3.141593" upper="3.141593" effort="0.0" velocity="0.0"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <!-- [Joint] l_knee_pitch_joint -->
    <joint name="l_knee_pitch_joint" type="revolute">
        <parent link="l_hip_roll_link"/>
        <child link="l_knee_crank_link"/>
        <origin xyz="-0.034801 -0.028600 -0.137750" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>
        <!-- RS03 ID4 : limit -180 ~ +180 deg until the Ver.2 joint-limit sweep; knee four-bar toggles 20 deg toward extension -->
        <limit lower="-3.141593" upper="3.141593" effort="60.0" velocity="20.9"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

