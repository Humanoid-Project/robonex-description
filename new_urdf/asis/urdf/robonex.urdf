<?xml version="1.0"?>
<robot name="robonex">

    <!-- RoboNex Ver.2, generated from Fusion 360 '2_RoboNex_test v1' by new_urdf/_extract (arms from the copy
         '2_RoboNex_urdf' with both elbows rotated 90 deg forward; every other part unchanged).
         Zero pose = that assembly pose (legs straight, elbows 90 deg forward); every link frame is parallel
         to base_link.
         Axes: X forward, Y left, Z up. Meshes are in their link frame (mm, scale 0.001).
         Actuated joint limits are -pi..+pi until the Ver.2 joint-limit sweep.
         Arm joints (RS02) and neck_pitch_joint (RS05) are not in robonex-common. -->

    <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <material name="gray">
        <color rgba="0.647 0.647 0.647 1.0"/>
    </material>

