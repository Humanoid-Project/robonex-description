<?xml version="1.0"?>
<robot name="robonex_edu">

    <!-- RoboNex Ver.2-2 edu (lower body, battery and e-stop split out of base_link): ver2-2/scripts/model_tools.py build
         from the Fusion 360 export package new2_urdf (link-level inertials with motors included,
         user-confirmed masses), re-posed so that both soles are
         level at the zero pose (same motion as Ver.2). battery_link and estop_link are fixed to base_link;
         their frames are their COMs. Every link frame is parallel to base_link at zero: X forward, Y left,
         Z up. Meshes in link frames (mm). Joint limits are -pi..+pi until the Ver.2 joint-limit sweep. -->

    <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <material name="gray">
        <color rgba="0.647 0.647 0.647 1.0"/>
    </material>

    <!-- [Link] base_link -->
    <link name="base_link">
        <inertial>
            <origin xyz="0.013148 -0.005915 -0.005744" rpy="0 0 0"/>
            <mass value="3.676900"/>
            <inertia ixx="0.08826882" ixy="0.00038825" ixz="-0.00152143" iyy="0.07767180" iyz="0.00319883" izz="0.02335333"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../meshes/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black"/>
        </visual>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../meshes/rs02_l_hip_yaw.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../meshes/rs02_r_hip_yaw.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="gray"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
