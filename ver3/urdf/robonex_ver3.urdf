        <limit lower="-3.141593" upper="3.141593" effort="5.5" velocity="50.3"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <!-- [Joint] neck_pitch_joint -->
    <joint name="neck_pitch_joint" type="revolute">
        <parent link="neck_yaw_link"/>
        <child link="neck_pitch_link"/>
        <origin xyz="0.000000 -0.000086 0.034150" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>
        <!-- RS05 ID27 : limit -180 ~ +180 deg placeholder (command limits in robonex-common); effort/velocity = common PEAK_TORQUE / NO_LOAD_SPEED -->
        <limit lower="-3.141593" upper="3.141593" effort="5.5" velocity="50.3"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <!-- [Joint] head_joint: head (shell + camera) fixed on the neck pitch link, zero offset -->
    <joint name="head_joint" type="fixed">
        <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
        <parent link="neck_pitch_link"/>
        <child link="head_link"/>
    </joint>

    <!-- [Link] d435_link: RealSense D435i front glass centre, X forward (frame only) -->
    <link name="d435_link"/>

    <!-- [Joint] d435_joint -->
    <joint name="d435_joint" type="fixed">
        <origin xyz="0.059950 0.000086 0.021540" rpy="0 0 0"/>
        <parent link="head_link"/>
        <child link="d435_link"/>
    </joint>

</robot>
