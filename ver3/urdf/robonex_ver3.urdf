<?xml version="1.0"?>
<robot name="robonex">

    <!-- RoboNex Ver.3 (full body: legs, torso, arms, neck, head). Generated by new5_urdf/_work/make_urdf5.py from the
         Fusion 360 model 'Ver.3/Ver3_RoboNex' (copy of the colleague's 'Ver.3/3_RoboNex').
         Axes: X forward, Y left, Z up. Every link frame is parallel to base_link at the zero pose.
         base_link origin: midway between the two hip-yaw axes (hips at y = +-0.043), same as Ver.2-4.
         Legs: the Ver.2-4 leg (same parts, same joint origins, 100 mm knee crank, level-sole zero pose).
         Zero pose: legs straight, soles level, upper arms hanging down, forearms forward (elbows at 90 deg, as Unitree G1),
         head facing forward.
         Names follow the Unitree G1 format: left_ / right_, the child link of <x>_joint is <x>_link; the head is
         head_link on the fixed head_joint after neck_pitch_link.
         Left and right joint origins and inertials are exact mirrors (CAD values of the two sides averaged).
         Masses: measured, Notion "part masses" (legs: the Ver.2-4 values, left/right averaged; upper body 2026-11-26).
         Fasteners and cables are added to the part they hold; a link inertial includes the motors mounted on it.
         Meshes are in their link frame (mm, scale 0.001). Loop closures are in loop_closures.yaml.
         d435_link is a frame only (RealSense front glass centre); it carries no mass.
         Joint limits are -pi..+pi placeholders. -->

    <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <material name="gray">
        <color rgba="0.647 0.647 0.647 1.0"/>
    </material>

